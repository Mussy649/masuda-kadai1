    <diagram name="ユースケース" id="2ejexZxvPRelAa5kF1TG">
        <mxGraphModel dx="761" dy="702" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="WHpyJYZ-l_GldMlXBxn8-1" value="&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;①訪問者は氏名、性別、メールアドレス、電話番号、&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;住所、&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;建物名、お問い合わせ種類、お問い合わせ内容&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;を入力できる&lt;/span&gt;&lt;div&gt;&lt;div&gt;②訪問者は入力内容確認画面で内容を確認できる&lt;/div&gt;&lt;div&gt;③訪問者は修正する場合、入力画面に戻ることができる&lt;/div&gt;&lt;div&gt;④訪問者はお問い合わせ内容を送信できる&lt;/div&gt;&lt;div&gt;⑤送信後、サンクスページが表示される&lt;/div&gt;&lt;div&gt;⑥管理者は管理者登録・ログイン・ログアウトができる&lt;/div&gt;&lt;div&gt;⑦管理者はログイン後のみ管理画面を利用できる&lt;/div&gt;&lt;div&gt;⑧管理画面ではお問い合わせ一覧を確認できる&lt;/div&gt;&lt;div&gt;⑨管理画面では検索、詳細確認、削除、&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;CSVエクスポート&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ができる&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="160" y="100" width="310" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="WHpyJYZ-l_GldMlXBxn8-2" value="要件一覧" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
