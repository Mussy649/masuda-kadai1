                <mxCell id="WHpyJYZ-l_GldMlXBxn8-4" value="&lt;div style=&quot;text-align: left;&quot;&gt;*訪問者：お問い合わせフォームを利用する人&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*管理者：ログイン後にお問い合わせ内容を管理する人&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="160" y="420" width="320" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="WHpyJYZ-l_GldMlXBxn8-5" value="補足" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
